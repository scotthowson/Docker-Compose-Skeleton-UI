{
  "name": "docker-compose-skeleton-ui",
  "version": "1.0.0",
  "description": "Premium Electron desktop application for Docker Compose Skeleton management",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "Docker Compose Skeleton",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.14.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "wait-on": "^8.0.1"
  }
}
